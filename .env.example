# Supabase
# Сервер читает и NEXT_PUBLIC_*-имена, и короткие SUPABASE_*.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres для серверных действий и seed. Второе имя — запасное.
DATABASE_URL=
SUPABASE_DB_URL=

# Football data (football-data.org v4). FOOTBALL_DATA_ORG_TOKEN — старое имя.
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_ORG_TOKEN=
RAPIDAPI_KEY=
RAPIDAPI_HOST=football-leagues1.p.rapidapi.com

# Admin & cron
ADMIN_EMAILS=
# Bearer-токен для Vercel Cron или ?secret= для ручного запуска и pg_cron.
CRON_SECRET=

# DEMO/TEST сид (scripts/seed.ts): создаёт тестовые аккаунты с общим паролем.
# Не использовать для продакшена. Для прода: bootstrap:admin + bootstrap:season.
SEED_PASSWORD=

# Безопасная инициализация (прод): первый администратор
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NICKNAME=Админ
# BOOTSTRAP_ADMIN_SET_PASSWORD=1

# Безопасная инициализация (прод): сезон и карта (без демо-данных)
BOOTSTRAP_SEASON_SLUG=winter-2026
BOOTSTRAP_SEASON_TITLE=Зимний сезон 2026
BOOTSTRAP_SEASON_START=2026-11-12
BOOTSTRAP_SEASON_END=2027-03-01
# BOOTSTRAP_BOARD_SEED=20261112
